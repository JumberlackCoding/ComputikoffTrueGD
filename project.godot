; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ComputikoffTrueGD"
run/main_scene="uid://cxv07nca3hed7"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=648
window/size/viewport_height=1152
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[file_customization]

folder_colors={
"res://Games/": "red",
"res://Games/Lost Cities/": "orange",
"res://Games/Lost Cities/Textures/": "green",
"res://Games/WordBreaker/": "yellow",
"res://Games/Yahtzee/": "teal",
"res://Games/Yahtzee/Textures/": "green",
"res://MainMenu/": "orange",
"res://MainMenu/Scripts/": "yellow",
"res://Theme/": "blue"
}

[gui]

theme/custom="uid://di7wlu4ix6g1j"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
